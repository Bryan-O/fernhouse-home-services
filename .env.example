# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# Supabase (build step 3) — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security — never expose it to the browser.
SUPABASE_SECRET_KEY=

# Encrypts access notes and gate codes before they're stored (build step 4). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: losing it makes saved access notes unreadable.
FIELD_ENCRYPTION_KEY=

# Stripe (build step 5) — Developers → API keys. Use test keys (sk_test_…) until launch.
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint https://<your-domain>/api/stripe/webhook, events:
#   checkout.session.completed, checkout.session.expired, payment_intent.succeeded,
#   payment_intent.payment_failed, charge.succeeded, charge.refunded
STRIPE_WEBHOOK_SECRET=
# Optional: the site's public origin for Stripe return links (defaults to https://fernhouseclean.com in production)
SITE_ORIGIN=

# Twilio texts (build step 7) — Console → Account info. Ask before using live credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The texting number in E.164 (+16784396213), or a Messaging Service SID (MG…) — preferred:
# turn on Smart Encoding and Advanced Opt-Out there. Webhooks:
#   A message comes in → https://<your-domain>/api/twilio/sms (POST)
#   Delivery reports are requested per message → /api/twilio/status
TWILIO_FROM=
# Resend email (build step 7) — API Keys. Verify the sending domain first (bookings@<your-domain>).
RESEND_API_KEY=
# Owner alerts: your own mobile (E.164) for new-booking and problem texts, and the inbox for alert emails
# (defaults to the business Gmail).
OWNER_ALERT_MOBILE=
OWNER_ALERT_EMAIL=

# Scheduled jobs (build step 8). Vercel Cron calls /api/cron every hour (vercel.json) and sends
# this as "Authorization: Bearer <CRON_SECRET>". Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Analytics and ads (build step 10). All optional: without them nothing loads or is sent.
# Google Analytics 4 → Admin → Data streams → Measurement ID (G-…). In that stream's Enhanced
# measurement settings, turn OFF "Page changes based on browser history events" — the site
# sends its own page views with private parts of addresses removed.
NEXT_PUBLIC_GA4_ID=
# Meta Events Manager → your Pixel's ID (a number).
NEXT_PUBLIC_META_PIXEL_ID=
# Events Manager → Settings → Conversions API → Generate access token. Server only.
META_CAPI_TOKEN=
# Optional while testing: the "Test events" code, so test bookings show there instead of in reports.
META_CAPI_TEST_CODE=
