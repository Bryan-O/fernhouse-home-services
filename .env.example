# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# Supabase (build step 3) — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security — never expose it to the browser.
SUPABASE_SECRET_KEY=

# Encrypts access notes and gate codes before they're stored (build step 4). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: losing it makes saved access notes unreadable.
FIELD_ENCRYPTION_KEY=

# Stripe (build step 5) — Developers → API keys. Use test keys (sk_test_…) until launch.
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint https://<your-domain>/api/stripe/webhook, events:
#   checkout.session.completed, checkout.session.expired, payment_intent.succeeded,
#   payment_intent.payment_failed, charge.succeeded, charge.refunded
STRIPE_WEBHOOK_SECRET=
# Optional: the site's public origin for Stripe return links (defaults to https://fernhouseclean.com in production)
SITE_ORIGIN=
